# ── Vercel 환경변수 ──────────────────────────────────────────────
# 아무것도 설정하지 않아도 앱은 그대로 동작한다.
# 로그인·동기화·문의·어드민만 꺼진 상태가 된다.

# Neon Postgres (Vercel > Storage > Neon 연결 시 자동 주입)
DATABASE_URL=

# Auth.js — openssl rand -base64 32 로 생성
AUTH_SECRET=

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID (웹)
#   승인된 자바스크립트 원본:  https://ilgik.vercel.app
#   승인된 리디렉션 URI:       https://ilgik.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# /admin 에 들어갈 수 있는 Gmail 주소. 쉼표로 여러 개
ADMIN_EMAILS=
